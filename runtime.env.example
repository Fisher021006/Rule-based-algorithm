# ROS 消息类型
export ROS_CONTROLCMD_MSG=common_msgs.msg.controlcmd
export ROS_SENSORGPS_MSG=common_msgs.msg.sensorgps
export ROS_ACTUATOR_MSG=common_msgs.msg.actuator
# 若启用 OBU 障碍物输入，通常可直接使用 common_msgs.msg.obupants
export ROS_OBU_MSG=common_msgs.msg.obupants

# ROS topic 名称
export ROS_SENSORGPS_TOPIC=/sensorgps
export ROS_ACTUATOR_TOPIC=/actuator
export ROS_OBU_TOPIC=/obu/source
export ROS_CONTROLCMD_TOPIC=/controlcmd

# 算法参数
export ROS_PLAN_HZ=10
export ROS_CONTROL_HZ=50
export ROS_OBU_TRACK_TIMEOUT_MS=1000
# 若需要固定指定某辆 OBU 车作为场景主车，填写对应 ptc_id；留空则按场景默认规则选取
export ROS_SCENE_MAIN_PTC_ID=

# 若车端实际定义为 lon=经度、lat=纬度，保持 0
# 只有在车端消息字段实际反着用时，才改成 1
export ROS_SENSORGPS_SWAP_LATLON=0

# 当前 common_msgs/sensorgps.msg 中 velocity 约定为 m/s，保持 1.0
# 若车端实际给的是 km/h，再改成 0.2777777778
export ROS_SENSORGPS_SPEED_SCALE=1.0
